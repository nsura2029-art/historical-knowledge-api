{
  "name": "@hka/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "dev:smoke": "node scripts/smoke.mjs http://127.0.0.1:8787",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:prod": "wrangler deploy --env production",
    "preview:smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@hka/contracts": "workspace:*",
    "@hka/db": "workspace:*",
    "@hono/zod-openapi": "^0.19.0",
    "@scalar/hono-api-reference": "^0.5.0",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20240821.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "wrangler": "^3.78.0"
  }
}
